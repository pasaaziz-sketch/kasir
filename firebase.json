{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {"source": "/@(index.html|sw.js|firebase-config.js)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
